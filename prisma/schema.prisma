datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  ADMIN
  SUPER_ADMIN
  ORGANIZER
  STAFF
  PARTICIPANT
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  EVENT_COMPLETED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  ATTENDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ----------------------------------------------------
// AUTH & USERS (Better Auth Compatible)
// ----------------------------------------------------

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  role          Role         @default(PARTICIPANT)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  participant   Participant?
  auditLogs     AuditLog[]
  staffCheckIns CheckIn[]    @relation("StaffCheckIns")

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

// ----------------------------------------------------
// PARTICIPANT PROFILE
// ----------------------------------------------------

model Participant {
  id                 String         @id @default(cuid())
  userId             String         @unique
  name               String
  email              String         @unique
  phone              String
  college            String
  department         String
  year               String
  imageUrl           String?
  cloudinaryPublicId String?
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrations      Registration[]
  certificates       Certificate[]
  teamMemberships    TeamMember[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([email])
  @@index([phone])
  @@index([college])
}

// ----------------------------------------------------
// EVENT DOMAIN
// ----------------------------------------------------

model EventCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  events      Event[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id                   String          @id @default(cuid())
  name                 String
  slug                 String          @unique
  description          String          @db.Text
  venue                String
  startAt              DateTime
  endAt                DateTime
  capacity             Int
  registrationOpen     Boolean         @default(true)
  registrationDeadline DateTime
  status               EventStatus     @default(DRAFT)
  posterUrl            String?
  isTeamEvent          Boolean         @default(false)
  minTeamSize          Int             @default(1)
  maxTeamSize          Int             @default(1)
  categoryId           String?
  category             EventCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  registrations        Registration[]
  teams                Team[]
  certificates         Certificate[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([slug])
  @@index([status])
  @@index([startAt])
}

// ----------------------------------------------------
// TEAMS
// ----------------------------------------------------

model Team {
  id            String         @id @default(cuid())
  name          String
  eventId       String
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  leaderId      String
  members       TeamMember[]
  registrations Registration[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([name, eventId])
  @@index([eventId])
}

model TeamMember {
  id            String       @id @default(cuid())
  teamId        String
  name          String
  email         String?
  phone         String
  college       String?
  department    String?
  year          String?
  collegeIdUrl  String?
  participantId String?
  transportOptIn Boolean      @default(false)
  pickupRoute    String?
  pickupStop     String?
  pickupLandmark String?
  team          Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@index([teamId])
  @@index([pickupRoute])
}

// ----------------------------------------------------
// REGISTRATIONS & CHECK-IN
// ----------------------------------------------------

model Registration {
  id                 String             @id @default(cuid())
  registrationNumber String             @unique
  participantId      String
  eventId            String
  teamId             String?
  status             RegistrationStatus @default(CONFIRMED)
  paymentStatus      PaymentStatus      @default(COMPLETED)
  qrToken            String             @unique
  checkedIn          Boolean            @default(false)
  transportOptIn     Boolean            @default(false)
  samePickupForTeam  Boolean            @default(true)
  pickupRoute        String?
  pickupStop         String?
  pickupLandmark     String?
  passengersCount    Int                @default(1)
  participant        Participant        @relation(fields: [participantId], references: [id], onDelete: Restrict)
  event              Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  team               Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  payment            Payment?
  checkIn            CheckIn?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([participantId, eventId], name: "participant_event_unique")
  @@index([registrationNumber])
  @@index([qrToken])
  @@index([status])
  @@index([checkedIn])
  @@index([transportOptIn])
  @@index([pickupRoute])
}

model Payment {
  id             String        @id @default(cuid())
  registrationId String        @unique
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("INR")
  status         PaymentStatus @default(PENDING)
  provider       String?
  transactionId  String?       @unique
  registration   Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model CheckIn {
  id             String       @id @default(cuid())
  registrationId String       @unique
  staffId        String
  checkedInAt    DateTime     @default(now())
  deviceInfo     String?
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  staff          User         @relation("StaffCheckIns", fields: [staffId], references: [id], onDelete: Restrict)

  @@index([staffId])
  @@index([checkedInAt])
}

// ----------------------------------------------------
// CERTIFICATES & AUDIT LOGS
// ----------------------------------------------------

model Certificate {
  id             String      @id @default(cuid())
  participantId  String
  eventId        String
  certificateUrl String
  issuedAt       DateTime    @default(now())
  participant    Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  event          Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([participantId, eventId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}
